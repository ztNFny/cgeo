<?xml version="1.0" encoding="UTF-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:key="@string/preference_screen_projectgc"
    android:title="@string/init_projectgc" >

    <PreferenceCategory
        android:title="@string/settings_settings"
        app:iconSpaceReserved="false" >
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="@string/pref_connectorProjectGCActive"
            android:title="@string/settings_service_activate"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="@string/pref_fakekey_info_projectgc"
            android:summary="@string/pgc_info_plus_summary"
            android:title="@string/pgc_info_plus_title"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            android:dependency="@string/pref_connectorProjectGCActive"
            android:key="@string/pref_pgc_access_token"
            android:title="@string/pgc_access_token_title"
            app:iconSpaceReserved="false" />
        <Preference
            android:dependency="@string/pref_connectorProjectGCActive"
            android:key="@string/pref_fakekey_pgc_get_token"
            android:title="@string/pgc_get_access_token"
            app:summary="@string/pgc_settings_description"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pgc_challenge_checker"
        app:iconSpaceReserved="false" >
        <CheckBoxPreference
            android:dependency="@string/pref_connectorProjectGCActive"
            android:key="@string/pref_pgc_challenge_update_cache_icon"
            android:defaultValue="true"
            android:title="@string/pgc_challenge_update_cache_icon"
            android:summaryOn="@string/pgc_challenge_update_cache_icon_on"
            android:summaryOff="@string/pgc_challenge_update_cache_icon_off"
            app:iconSpaceReserved="false" />
        <Preference
            android:dependency="@string/pref_pgc_challenge_update_cache_icon"
            android:key="@string/pref_pgc_challenge_success_icon"
            android:title="@string/pgc_challenge_icon_fulfilled"
            app:iconSpaceReserved="false" />
        <Preference
            android:dependency="@string/pref_pgc_challenge_update_cache_icon"
            android:key="@string/pref_pgc_challenge_failure_icon"
            android:title="@string/pgc_challenge_icon_not_fulfilled"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_information"
        app:iconSpaceReserved="false" >
        <Preference
            android:key="@string/pref_fakekey_pgc_website"
            android:title="@string/settings_open_website"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
